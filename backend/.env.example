DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost/findtunes
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
GENIUS_CLIENT_ACCESS_TOKEN=
PINECONE_API_KEY=
PINECONE_HOST=
RAG_ENABLED=true
